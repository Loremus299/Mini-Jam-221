pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
glb = {
	score = 0,
	time = 3600
}

sd = {
  mapX = 0,
  mapY = 0
}

plr = {
	x = 0, y = 0,
  w = 1, h = 1,

	spr = 1,
  fx = false, fy = false,

  animState = "",
  animIndex = 1,

  anims = {
    animName = { 1, 2, 3 }
  },

	dx = 0, dy = 0,

	ax = 8, ay = 8
}

function onDown(k, f)
  if btn(k) then
    f()
  end
end

function onClick(k, f)
  if btnp(k) then
    f()
  end
end

function collide(o, sd, f)
  local tx = flr(o.x / 8) + (sd.mapX * 16)
  local ty = flr(o.y / 8) + (sd.mapY * 16)
  local tw = flr((o.x + o.w * 8 - 1) / 8) + (sd.mapX * 16)
  local th = flr((o.y + o.h * 8 - 1) / 8) + (sd.mapY * 16)

  return fget(mget(tx, ty), f)
      or fget(mget(tw, ty), f)
      or fget(mget(tx, th), f)
      or fget(mget(tw, th), f)
end
-->8
function movement(o)
	onClick(1, function() 
		o.dx += o.ax
	end)

	onClick(0, function() 
		o.dx -= o.ax
	end)

	o.x += o.dx

	if collide(o, sd, 0) then
		o.x -= o.dx
		o.dx = 0
	end

	if not btn(0) or not btn(1) then
		o.dx = 0
	end

	onClick(3, function() 
		o.dy += o.ay
	end)

	onClick(2, function() 
		o.dy -= o.ay
	end)

	o.y += o.dy

	if collide(o, sd, 0) then
		o.y -= o.dy
		o.dy = 0
	end

	if not btn(2) or not btn(3) then
		o.dy = 0
	end
end

function collectCoin(o, sd)
	mset(flr(o.x / 8) + (sd.mapX * 16), flr(o.y / 8) + (sd.mapY * 16), 0)
	glb.score += 1
end
-->8
function mapInit()
end

function mapUpdate()
	glb.time -= 1
	movement(plr)

	if plr.x >= ((sd.mapX + 1)) * 128 then
		sd.mapX += 1
		plr.x -= 128
	end

	if plr.x < 0 then
		sd.mapX -= 1
		plr.x = 120
	end


	if plr.y >= ((sd.mapY + 1)) * 128 then
		sd.mapY += 1
		plr.y -= 128
	end

	if plr.y < 0 then
		sd.mapY -= 1
		plr.y = 120
	end
	
	if collide(plr, sd, 1) then 
		collectCoin(plr, sd)
	end
end

function mapDraw()
	cls()
	map(sd.mapX * 16, sd.mapY * 16)
	spr(plr.spr, plr.x, plr.y, plr.w, plr.h, plr.fx, plr.fy)
	print(glb.score, 2, 122, 3)
	print(flr(glb.time / 60), 2, 2, 3)
end

function roomInit()
	sd.mapX = 7
	sd.mapY = 3
	plr.x = 8
	plr.y = 8
end

function roomUpdate()
	movement(plr)
end

function roomDraw()
	cls(4)
	map(sd.mapX * 16, sd.mapY * 16)
	spr(plr.spr, plr.x, plr.y, plr.w, plr.h, plr.fx, plr.fy)
end

-->8
sceneManager = {
  map = {
    init = mapInit,
    update = mapUpdate,
    draw = mapDraw,
  },
  room = {
	init = roomInit,
	update = roomUpdate,
	draw = roomDraw
  },
  cur = "room"
}

function _init() 
	sceneManager[sceneManager.cur].init()
end

function _update() 
	sceneManager[sceneManager.cur].update()
end

function _draw() 
	sceneManager[sceneManager.cur].draw()
end
