pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
glb = {
	score = 0,
	time = 3600
}

sd = {
  mapX = 0,
  mapY = 0
}

plr = {
	x = 0, y = 0,
  w = 1, h = 1,

	spr = 1,
  fx = false, fy = false,

  animState = "",
  animIndex = 1,

  anims = {
    animName = { 1, 2, 3 }
  },

	dx = 0, dy = 0,

	ax = 8, ay = 8
}

function onDown(k, f)
  if btn(k) then
    f()
  end
end

function onClick(k, f)
  if btnp(k) then
    f()
  end
end

function collide(o, sd, f)
  local tx = flr(o.x / 8) + (sd.mapX * 16)
  local ty = flr(o.y / 8) + (sd.mapY * 16)
  local tw = flr((o.x + o.w * 8 - 1) / 8) + (sd.mapX * 16)
  local th = flr((o.y + o.h * 8 - 1) / 8) + (sd.mapY * 16)

  return fget(mget(tx, ty), f)
      or fget(mget(tw, ty), f)
      or fget(mget(tx, th), f)
      or fget(mget(tw, th), f)
end
-->8
function movement(o)
	onClick(1, function() 
		o.dx += o.ax
	end)

	onClick(0, function() 
		o.dx -= o.ax
	end)

	o.x += o.dx

	if collide(o, sd, 0) then
		o.x -= o.dx
		o.dx = 0
	end

	if not btn(0) or not btn(1) then
		o.dx = 0
	end

	onClick(3, function() 
		o.dy += o.ay
	end)

	onClick(2, function() 
		o.dy -= o.ay
	end)

	o.y += o.dy

	if collide(o, sd, 0) then
		o.y -= o.dy
		o.dy = 0
	end

	if not btn(2) or not btn(3) then
		o.dy = 0
	end
end

function collectCoin(o)
	mset(o.x / 8, o.y / 8, 0)
	glb.score += 1
end
-->8
function s0init()
end

function s0update()
	glb.time -= 1

	movement(plr)
	
	if collide(plr, sd, 1) then 
		collectCoin(plr)
	end
end

function s0draw()
	cls()
	map(sd.mapX, sd.mapY)
	spr(plr.spr, plr.x, plr.y, plr.w, plr.h, plr.fx, plr.fy)
	print(glb.score, 2,122, 0)
	print(flr(glb.time / 60), 119,122,0)
end
-->8
sceneManager = {
  s0 = {
    init = s0init,
    update = s0update,
    draw = s0draw,
  },
  cur = "s0"
}

function _init() 
	sceneManager[sceneManager.cur].init()
end

function _update() 
	sceneManager[sceneManager.cur].update()
end

function _draw() 
	sceneManager[sceneManager.cur].draw()
end
