pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
	glb = {
	score = 0,
	time = 1800,
	keys = 0,
	debugLeafCount = 0
}

sd = {
  mapX = 0,
  mapY = 0
}

plr = {
	x = 0, y = 0,
  w = 1, h = 1,

	spr = 1,
  fx = false, fy = false,

  animState = "walk",
  animIndex = 1,

  anims = {
    walk = { 1, 1, 1, 1, 1, 1, 1, 17, 17, 17, 17, 17, 17, 17 },
  },

	dx = 0, dy = 0,

	ax = 2, ay = 2
}

function onDown(k, f)
  if btn(k) then
    f()
  end
end

function onClick(k, f)
  if btnp(k) then
    f()
  end
end

function collide(o, sd, f)
  local tx = flr(o.x / 8) + (sd.mapX * 16)
  local ty = flr(o.y / 8) + (sd.mapY * 16)
  local tw = flr((o.x + o.w * 8 - 1) / 8) + (sd.mapX * 16)
  local th = flr((o.y + o.h * 8 - 1) / 8) + (sd.mapY * 16)

  return fget(mget(tx, ty), f)
      or fget(mget(tw, ty), f)
      or fget(mget(tx, th), f)
      or fget(mget(tw, th), f)
end

function findFlagTile(o, sd, flag)
	local tx = flr(o.x / 8) + sd.mapX * 16
	local ty = flr(o.y / 8) + sd.mapY * 16
	local tw = flr((o.x + o.w * 8 - 1) / 8) + sd.mapX * 16
	local th = flr((o.y + o.h * 8 - 1) / 8) + sd.mapY * 16

	if fget(mget(tx, ty), flag) then return tx, ty end
	if fget(mget(tw, ty), flag) then return tw, ty end
	if fget(mget(tx, th), flag) then return tx, th end
	if fget(mget(tw, th), flag) then return tw, th end
end
-->8
function movement(o)
	onDown(1, function() 
		o.dx += o.ax
	end)

	onDown(0, function() 
		o.dx -= o.ax
	end)

	o.x += o.dx

	if collide(o, sd, 4) and glb.keys > 0 then
		local tx, ty = findFlagTile(plr, sd, 4)
		mset(tx, ty, 0)
		glb.keys -= 1
		glb.score += 5
		sfx(2)
	end


	if collide(o, sd, 0) then
		o.x -= o.dx
		o.dx = 0
	end

	if not btn(0) or not btn(1) then
		o.dx = 0
	end

	onDown(3, function() 
		o.dy += o.ay
	end)

	onDown(2, function() 
		o.dy -= o.ay
	end)

	o.y += o.dy

	if collide(o, sd, 4) and glb.keys > 0 then
		mset(flr(plr.x / 8) + (sd.mapX * 16), flr(plr.y / 8) + (sd.mapY * 16), 0)
		glb.keys -= 1
		glb.score += 10
	end

	if collide(o, sd, 0) then
		o.y -= o.dy
		o.dy = 0
	end

	local state = o.anims[o.animState]
	o.animIndex = (o.animIndex % #state) + 1
	o.spr = state[o.animIndex]

	if not btn(0) and not btn(1) and not btn(2) and not btn(3) then
		o.spr = 1
	end

	if btn(0) then
		o.fx = true
	end
	if btn(1) then
		o.fx = false
	end

	o.dx = 0
	o.dy = 0
end

function collectCoin(o, sd)
	local tx, ty = findFlagTile(o, sd, 1)
	if tx then
		mset(tx, ty, 0)
		glb.score += 1
		sfx(0)
		glb.debugLeafCount += 1
	end
end

function sceneTransition(o, sd, newScene)
	if collide(o, sd, 2) then
		sceneManager.cur = newScene
		sceneManager[newScene].init()
	end
end

ghosts = {}

ghost = {
	spr = 7, sp = 0,
	x = 0, y = 0,
	fx = false
}

function newGhost(x, y, sp)
	local ghostInstance = {
		spr = 7, sp = sp,
		x = x, y = y,
		fx = false
	}
	add(ghosts, ghostInstance)
end

function spawnGhosts(sd)
	if sd.mapX == 1 and sd.mapY == 0 then
		newGhost(112, 112, 1)
	end
	if sd.mapX == 0 and sd.mapY == 1 then
		newGhost(8, 60, 1)
	end
	if sd.mapX == 3 and sd.mapY == 0 then
		newGhost(64, 64, 1)
	end
	if sd.mapX == 4 and sd.mapY == 0 then
		newGhost(64, 64, 1)
	end
	if sd.mapX == 3 and sd.mapY == 1 then
		newGhost(120, 0, 1)
	end
	if sd.mapX == 1 and sd.mapY == 1 then
		newGhost(64, 64, 1)
	end
	if sd.mapX == 0 and sd.mapY == 2 then
		newGhost(0, 64, 1)
		newGhost(64, 64, 1)
	end
	if sd.mapX == 0 and sd.mapY == 3 then
		newGhost(120, 32, 0.5)
	end	
	if sd.mapX == 1 and sd.mapY == 3 then
		newGhost(120, 120, 1) 
	end
	if sd.mapX == 2 and sd.mapY == 3 then
		newGhost(64, 64, 1)
	end
	if sd.mapX == 4 and sd.mapY == 1 then
		newGhost(0, 120, 1)
	end
	if sd.mapX == 3 and sd.mapY == 2 then
		newGhost(64, 64, 1)
	end
	if sd.mapX == 2 and sd.mapY == 2 then
		newGhost(64, 64, 1)
	end
	if sd.mapX == 5 and sd.mapY == 1 then
		newGhost(120, 0, 1)
	end
	if sd.mapX == 4 and sd.mapY == 1 then
		newGhost(120, 0, 1)
		newGhost(0, 120, 1)
	end
end

function ghostMove(o)
	for ghost in all(ghosts) do
		if ghost.x > o.x then
			ghost.x -= ghost.sp
			ghost.fx = false
		end
		if ghost.x < o.x then
			ghost.x += ghost.sp
			ghost.fx = true
		end
		if ghost.y < o.y then
			ghost.y += ghost.sp
		end
		if ghost.y > o.y then
			ghost.y -= ghost.sp
		end

		if ghost.x < o.x + o.w * 8
		and ghost.x + 8 > o.x
		and ghost.y < o.y + o.h * 8
		and ghost.y + 8 > o.y then
			glb.score -= 5
			sfx(1)
			del(ghosts, ghost)
		end
	end
end
-->8
function mapInit()
	sd.mapX = 0
	sd.mapY = 0
	plr.x = 64
	plr.y = 64
	spawnGhosts(sd)
end

function mapUpdate()
	glb.time -= 1
	movement(plr)

	if plr.x >= 128 then
		sd.mapX += 1
		plr.x -= 128
		ghosts = {}
		spawnGhosts(sd)
	end

	if plr.x < 0 then
		sd.mapX -= 1
		plr.x = 120
		ghosts = {}
		spawnGhosts(sd)
	end


	if plr.y >= 128 then
		sd.mapY += 1
		plr.y -= 128
		ghosts = {}
		spawnGhosts(sd)
	end

	if plr.y < 0 then
		sd.mapY -= 1
		plr.y = 120
		ghosts = {}
		spawnGhosts(sd)
	end
	
	if collide(plr, sd, 1) then 
		collectCoin(plr, sd)
	end

	if collide(plr, sd, 3) then
		local tx, ty = findFlagTile(plr, sd, 3)
		mset(tx, ty, 0)
		glb.keys += 1
		sfx(3)
		glb.debugLeafCount += 1
	end
	ghostMove(plr)
	sceneTransition(plr, sd, "room")

	if glb.score < 0 then
		glb.score = 0
	end

	if glb.time == 600 then
		sfx(4)
	end

	if glb.time < 0 then
		sceneManager.cur = "hypo"
		sceneManager[sceneManager.cur].init()
	end
end

function mapDraw()
	cls()
	map(sd.mapX * 16, sd.mapY * 16)
	spr(plr.spr, plr.x, plr.y, plr.w, plr.h, plr.fx, plr.fy)
	print(chr(143)..glb.score, 10, 10, 9)
	print(chr(147)..flr(glb.time / 60), 10, 20, 12)
	if glb.time < 600 then
		print(chr(147)..flr(glb.time / 60), 10, 20, 8)
	end
	for i=0, glb.keys-1 do
		spr(3, 10 + (i * 8), 30)
	end
	for ghost in all(ghosts) do
		spr(ghost.spr, ghost.x, ghost.y, 1, 1, ghost.fx, ghost.fy)
	end
	if sd.mapX == 0 and sd.mapY == 0 then
		print("come home to burn leaves.", 10, 120, 3)
	end
end

function roomInit()
	deposit = 0
	depositTimer = 60
	sd.mapX = 7
	sd.mapY = 3
	plr.x = 8
	plr.y = 8
	ghosts = {}
end

function roomUpdate()
	glb.time -= 0.5
	movement(plr)
	sceneTransition(plr, sd, "map")

	onClick(4, function() 
		if glb.score > 0 then
			glb.time += glb.score * 120 
			deposit = glb.score
			glb.score = 0
		end
		if glb.debugLeafCount >= 104 then
			sceneManager.cur = "win"
			sceneManager[sceneManager.cur].init()
		end
	end)

	if glb.time < 0 then
		sceneManager.cur = "hypo"
		sceneManager[sceneManager.cur].init()
	end
end

function roomDraw()
	cls(6)
	map(sd.mapX * 16, sd.mapY * 16)
	spr(plr.spr, plr.x, plr.y, plr.w, plr.h, plr.fx, plr.fy)
	print(chr(143)..glb.score, 10, 10, 9)
	if deposit > 0 and depositTimer > 0 then
		depositTimer -= 1
		print("+ 2 x "..deposit )
	end
	print(chr(147)..flr(glb.time / 60), 10, 20, 12)
	print("remaining "..(104 - glb.debugLeafCount), 10, 104, 1)
	print("press 🅾️ to deposit leaves", 10, 114, 3)
end

function hypoInit()
	sd.mapX = 6
	sd.mapY = 3
	sfx(05)
end

function hypoUpdate()
	if btnp(4) then
		run()
	end
end

function hypoDraw()
	cls(0)
	map(sd.mapX * 16, sd.mapY * 16)
	print("you died of", 42, 54, 5)
	print("hypotermia.", 42, 64, 12)
	print("press 🅾️ to retry", 30, 74, 5)
end

function winInit()
	sd.mapX = 6
	sd.mapY = 3
end

function winUpdate()
	if btnp(4) then
		run()
	end
end

function winDraw()
	cls(0)
	map(sd.mapX * 16, sd.mapY * 16)
	print("you survived.", 42, 54, 9)
	print("the midnight.", 42, 64, 9)
	print("press 🅾️ to retry", 30, 74, 5)
end

function titleInit()
	sd.mapX = 7
	sd.mapY = 2
end

function titleUpdate()
	if btnp(4) then
		sceneManager.cur = "room"
		sceneManager[sceneManager.cur].init()
	end
end

function titleDraw()
	cls(0)
	map(sd.mapX * 16, sd.mapY * 16)
	print("cold night.", 48, 58, 12)
	print("press 🅾️ to start", 30, 74, 5)
end
-->8
sceneManager = {
  map = {
    init = mapInit,
    update = mapUpdate,
    draw = mapDraw,
  },
  room = {
	init = roomInit,
	update = roomUpdate,
	draw = roomDraw
  },
  hypo = {
    init = hypoInit,
    update = hypoUpdate,
    draw = hypoDraw
  },
	win = {
		init = winInit,
		update = winUpdate,
		draw = winDraw
	},
	title = {
		init = titleInit,
    update = titleUpdate,
    draw = titleDraw
	},
  cur = "title"
}
function _init() 
	sceneManager[sceneManager.cur].init()
end

function _update() 
	sceneManager[sceneManager.cur].update()
end

function _draw() 
	sceneManager[sceneManager.cur].draw()
end
