pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
glb = {
	score = 0,
	time = 1800,
	keys = 0
}

sd = {
  mapX = 0,
  mapY = 0
}

plr = {
	x = 0, y = 0,
  w = 1, h = 1,

	spr = 1,
  fx = false, fy = false,

  animState = "",
  animIndex = 1,

  anims = {
    animName = { 1, 2, 3 }
  },

	dx = 0, dy = 0,

	ax = 8, ay = 8
}

function onDown(k, f)
  if btn(k) then
    f()
  end
end

function onClick(k, f)
  if btnp(k) then
    f()
  end
end

function collide(o, sd, f)
  local tx = flr(o.x / 8) + (sd.mapX * 16)
  local ty = flr(o.y / 8) + (sd.mapY * 16)
  local tw = flr((o.x + o.w * 8 - 1) / 8) + (sd.mapX * 16)
  local th = flr((o.y + o.h * 8 - 1) / 8) + (sd.mapY * 16)

  return fget(mget(tx, ty), f)
      or fget(mget(tw, ty), f)
      or fget(mget(tx, th), f)
      or fget(mget(tw, th), f)
end
-->8
function movement(o)
	onClick(1, function() 
		o.dx += o.ax
	end)

	onClick(0, function() 
		o.dx -= o.ax
	end)

	o.x += o.dx

	if collide(o, sd, 4) and glb.keys > 0 then
		mset(flr(plr.x / 8) + (sd.mapX * 16), flr(plr.y / 8) + (sd.mapY * 16), 0)
		glb.keys -= 1
		glb.score += 5
	end


	if collide(o, sd, 0) then
		o.x -= o.dx
		o.dx = 0
	end

	if not btn(0) or not btn(1) then
		o.dx = 0
	end

	onClick(3, function() 
		o.dy += o.ay
	end)

	onClick(2, function() 
		o.dy -= o.ay
	end)

	o.y += o.dy

	if collide(o, sd, 4) and glb.keys > 0 then
		mset(flr(plr.x / 8) + (sd.mapX * 16), flr(plr.y / 8) + (sd.mapY * 16), 0)
		glb.keys -= 1
		glb.score += 10
	end

	if collide(o, sd, 0) then
		o.y -= o.dy
		o.dy = 0
	end

	if not btn(2) or not btn(3) then
		o.dy = 0
	end
end

function collectCoin(o, sd)
	mset(flr(o.x / 8) + (sd.mapX * 16), flr(o.y / 8) + (sd.mapY * 16), 0)
	glb.score += 1
end

function sceneTransition(o, sd, newScene)
	if collide(o, sd, 2) then
		sceneManager.cur = newScene
		sceneManager[newScene].init()
	end
end

ghosts = {}

ghost = {
	spr = 7, sp = 0,
	x = 0, y = 0,
	fx = false
}

function newGhost(x, y, sp)
	local ghostInstance = {
		spr = 7, sp = sp,
		x = x, y = y,
		fx = false
	}
	add(ghosts, ghostInstance)
end

function spawnGhosts(sd)
	if sd.mapX == 1 and sd.mapY == 0 then
		newGhost(112, 112, 0.75)
	end
	if sd.mapX == 0 and sd.mapY == 1 then
		newGhost(8, 60, 0.75)
	end
	if sd.mapX == 3 and sd.mapY == 0 then
		newGhost(64, 64, 0.75)
	end
	if sd.mapX == 4 and sd.mapY == 0 then
		newGhost(64, 64, 0.75)
	end
	if sd.mapX == 3 and sd.mapY == 1 then
		newGhost(120, 0, 0.75)
	end
	if sd.mapX == 1 and sd.mapY == 1 then
		newGhost(64, 64, 0.75)
	end
	if sd.mapX == 0 and sd.mapY == 2 then
		newGhost(0, 64, 0.75)
		newGhost(64, 64, 0.75)
	end
	if sd.mapX == 0 and sd.mapY == 3 then
		newGhost(120, 32, 1)
	end
		if sd.mapX == 1 and sd.mapY == 3 then
		newGhost(120, 120, 1)
	end
end

function ghostMove(o)
	for ghost in all(ghosts) do
		if ghost.x > o.x then
			ghost.x -= ghost.sp
			ghost.fx = false
		end
		if ghost.x < o.x then
			ghost.x += ghost.sp
			ghost.fx = true
		end
		if ghost.y < o.y then
			ghost.y += ghost.sp
		end
		if ghost.y > o.y then
			ghost.y -= ghost.sp
		end

		if ghost.x < o.x + o.w * 8
		and ghost.x + 8 > o.x
		and ghost.y < o.y + o.h * 8
		and ghost.y + 8 > o.y then
			glb.score -= 5
			del(ghosts, ghost)
		end
	end
end
-->8
function mapInit()
	sd.mapX = 0
	sd.mapY = 0
	plr.x = 64
	plr.y = 64
	spawnGhosts(sd)
end

function mapUpdate()
	glb.time -= 1
	movement(plr)

	if plr.x >= 128 then
		sd.mapX += 1
		plr.x -= 128
		ghosts = {}
		spawnGhosts(sd)
	end

	if plr.x < 0 then
		sd.mapX -= 1
		plr.x = 120
		ghosts = {}
		spawnGhosts(sd)
	end


	if plr.y >= 128 then
		sd.mapY += 1
		plr.y -= 128
		ghosts = {}
		spawnGhosts(sd)
	end

	if plr.y < 0 then
		sd.mapY -= 1
		plr.y = 120
		ghosts = {}
		spawnGhosts(sd)
	end
	
	if collide(plr, sd, 1) then 
		collectCoin(plr, sd)
	end

	if collide(plr, sd, 3) then
		mset(flr(plr.x / 8) + (sd.mapX * 16), flr(plr.y / 8) + (sd.mapY * 16), 0)
		glb.keys += 1
	end
	ghostMove(plr)
	sceneTransition(plr, sd, "room")
end

function mapDraw()
	cls()
	map(sd.mapX * 16, sd.mapY * 16)
	spr(plr.spr, plr.x, plr.y, plr.w, plr.h, plr.fx, plr.fy)
	print(glb.score, 2, 122, 3)
	print(flr(glb.time / 60), 2, 2, 3)
	for i=0, glb.keys-1 do
		spr(3,2 + (i * 8), 10)
	end
	for ghost in all(ghosts) do
		spr(ghost.spr, ghost.x, ghost.y, 1, 1, ghost.fx, ghost.fy)
	end
end

function roomInit()
	deposit = 0
	depositTimer = 60
	sd.mapX = 7
	sd.mapY = 3
	plr.x = 8
	plr.y = 8
	ghosts = {}
end

function roomUpdate()
	glb.time -= 0.5
	movement(plr)
	sceneTransition(plr, sd, "map")

	onClick(4, function() 
		if glb.score > 0 then
			glb.time += glb.score * 120 
			deposit = glb.score
			glb.score = 0
		end
	end)
end

function roomDraw()
	cls(4)
	map(sd.mapX * 16, sd.mapY * 16)
	spr(plr.spr, plr.x, plr.y, plr.w, plr.h, plr.fx, plr.fy)
	print(glb.score, 2, 122, 3)
	print(flr(glb.time / 60), 2, 2, 3)
	if deposit > 0 and depositTimer > 0 then
		depositTimer -= 1
		print("+ 2 x "..deposit )
	end
end

-->8
sceneManager = {
  map = {
    init = mapInit,
    update = mapUpdate,
    draw = mapDraw,
  },
  room = {
	init = roomInit,
	update = roomUpdate,
	draw = roomDraw
  },
  cur = "room"
}

function _init() 
	sceneManager[sceneManager.cur].init()
end

function _update() 
	sceneManager[sceneManager.cur].update()
end

function _draw() 
	sceneManager[sceneManager.cur].draw()
end
